<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="CYBER VARILLITA"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="@font/orbitron_black"
        android:shadowColor="@color/color_purple"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="15"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_current_file"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Archivo: tooloutput_1.txt"
        android:textColor="@color/color_yellow_glow"
        android:textSize="12sp"
        android:fontFamily="@font/orbitron_black"
        android:alpha="0.7"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/ll_totals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_current_file">

        <TextView
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOTAL: 0"
            android:textColor="@color/color_purple"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron_black"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_paid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAGADO: 0"
            android:textColor="@color/color_green"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron_black"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tv_np"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N-P: 0"
            android:textColor="@color/color_red"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron_black" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nombre del Cliente..."
        android:textColorHint="#44FFFFFF"
        android:textColor="@color/color_green"
        android:background="@drawable/edittext_cyber"
        android:padding="12dp"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:textSize="20sp"
        android:fontFamily="@font/orbitron_black"
        app:layout_constraintTop_toBottomOf="@id/ll_totals" />

    <HorizontalScrollView
        android:id="@+id/horizontal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/et_name"
        app:layout_constraintBottom_toTopOf="@id/ll_bottom_buttons">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Page 1: Grid of Buttons -->

            <!-- Page 2: Pizarra (Real-time output) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_grid"
                android:layout_width="350dp"
                android:layout_height="match_parent">

                <GridLayout
                    android:id="@+id/grid_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:columnOrderPreserved="false" />
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/layout_pizarra"
                android:layout_width="350dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@color/color_panel">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIZARRA DE SALIDAS"
                    android:textColor="@color/color_green"
                    android:textSize="14sp"
                    android:fontFamily="@font/orbitron_black"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tv_pizarra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No hay salidas registradas."
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/orbitron_black"
                        android:textIsSelectable="true" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/ll_bottom_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GUARDAR"
                android:textColor="@color/white"
                android:fontFamily="@font/orbitron_black"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1A401A" />

            <Button
                android:id="@+id/btn_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EXPORTAR"
                android:textColor="@color/white"
                android:fontFamily="@font/orbitron_black"
                android:textSize="14sp"
                android:backgroundTint="#0D3333" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_new_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NUEVO"
                android:textColor="@color/white"
                android:fontFamily="@font/orbitron_black"
                android:textSize="14sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#330D33" />

            <Button
                android:id="@+id/btn_delete_last"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BORRAR"
                android:textColor="@color/white"
                android:fontFamily="@font/orbitron_black"
                android:textSize="14sp"
                android:backgroundTint="#400D1A" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>